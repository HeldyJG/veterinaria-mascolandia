# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL
# En Render puedes usar DATABASE_URL directamente (recomendado)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# O bien las variables individuales (si no usas DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veterinaria_db
DB_USER=postgres
DB_PASSWORD=tu_password

# Sesión
SESSION_SECRET=cambia_esto_por_una_clave_segura_larga

# Entorno
NODE_ENV=production

# Puerto (Render lo asigna automáticamente, no lo cambies)
# PORT=3000
