<form method="POST" action="/clientes/<%= cliente.id %>?_method=PUT" novalidate>
  <input type="hidden" name="returnTo" value="list">
  <div class="form-group">
    <label for="modal-edit-cliente-nombre" class="form-label">Nombre completo <span class="text-danger">*</span></label>
    <input type="text" id="modal-edit-cliente-nombre" name="nombreCompleto" class="form-control" value="<%= cliente.nombreCompleto %>" maxlength="150" required>
  </div>
  <div class="form-group">
    <label for="modal-edit-cliente-dni" class="form-label">DNI</label>
    <input type="text" id="modal-edit-cliente-dni" name="dni" class="form-control" value="<%= cliente.dni || '' %>" maxlength="20">
  </div>
  <div class="form-group">
    <label for="modal-edit-cliente-direccion" class="form-label">Dirección <span class="text-danger">*</span></label>
    <input type="text" id="modal-edit-cliente-direccion" name="direccion" class="form-control" value="<%= cliente.direccion %>" maxlength="200" required>
  </div>
  <div class="form-group">
    <label for="modal-edit-cliente-telefono" class="form-label">Teléfono <span class="text-danger">*</span></label>
    <input type="text" id="modal-edit-cliente-telefono" name="telefono" class="form-control" value="<%= cliente.telefono %>" maxlength="20" required>
  </div>
  <div class="form-group">
    <label for="modal-edit-cliente-correo" class="form-label">Correo electrónico</label>
    <input type="email" id="modal-edit-cliente-correo" name="correo" class="form-control" value="<%= cliente.correo || '' %>" maxlength="150">
  </div>
  <div class="form-actions">
    <button type="button" class="btn btn-outline" data-modal-close="modal-gestion">Cancelar</button>
    <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar cambios</button>
  </div>
</form>
