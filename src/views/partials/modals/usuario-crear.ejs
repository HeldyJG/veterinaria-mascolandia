<%- include('../modal-start', { modalId: 'modal-crear-usuario', modalTitle: 'Registrar usuario', modalIcon: 'user-plus' }) %>
<form method="POST" action="/usuarios" novalidate>
  <div class="form-group">
    <label for="modal-usuario-nombre" class="form-label">Nombre completo <span class="text-danger">*</span></label>
    <input type="text" id="modal-usuario-nombre" name="nombre" class="form-control" minlength="3" maxlength="100" required>
  </div>
  <div class="form-group">
    <label for="modal-usuario-login" class="form-label">Usuario <span class="text-danger">*</span></label>
    <input type="text" id="modal-usuario-login" name="usuario" class="form-control" minlength="4" maxlength="50" pattern="[a-zA-Z0-9._-]+" required>
  </div>
  <div class="form-group">
    <label for="modal-usuario-correo" class="form-label">Correo</label>
    <input type="email" id="modal-usuario-correo" name="correo" class="form-control" maxlength="255">
  </div>
  <div class="form-group">
    <label for="modal-usuario-perfil" class="form-label">Perfil <span class="text-danger">*</span></label>
    <select id="modal-usuario-perfil" name="idPerfil" class="form-control" required>
      <option value="">— Seleccione —</option>
      <% (perfiles || []).forEach(p => { %>
        <option value="<%= p.id %>"><%= p.nombre %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group">
    <label for="modal-usuario-clave" class="form-label">Contraseña <span class="text-danger">*</span></label>
    <input type="password" id="modal-usuario-clave" name="clave" class="form-control" minlength="8" required autocomplete="new-password">
    <small class="form-hint">Mínimo 8 caracteres, letra y número.</small>
  </div>
  <div class="form-actions">
    <button type="button" class="btn btn-outline" data-modal-close="modal-crear-usuario">Cancelar</button>
    <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Registrar</button>
  </div>
</form>
<%- include('../modal-end') %>
