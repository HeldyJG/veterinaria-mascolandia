<%- include('../modal-start', { modalId: 'modal-crear-proveedor', modalTitle: 'Registrar proveedor', modalIcon: 'building-2', modalSize: 'modal-lg' }) %>
<form method="POST" action="/proveedores" novalidate
      data-ajax-modal="true" data-modal-id="modal-crear-proveedor">
  <div class="form-group">
    <label for="modal-prov-nombre" class="form-label">Nombre de empresa <span class="text-danger">*</span></label>
    <input type="text" id="modal-prov-nombre" name="nombreEmpresa" class="form-control" maxlength="150" required>
  </div>
  <div class="form-row-2">
    <div class="form-group">
      <label for="modal-prov-ruc" class="form-label">RUC</label>
      <input type="text" id="modal-prov-ruc" name="ruc" class="form-control" maxlength="11" pattern="\d{11}">
    </div>
    <div class="form-group">
      <label for="modal-prov-tel" class="form-label">Teléfono <span class="text-danger">*</span></label>
      <input type="text" id="modal-prov-tel" name="telefono" class="form-control" maxlength="20" required>
    </div>
  </div>
  <div class="form-group">
    <label for="modal-prov-correo" class="form-label">Correo</label>
    <input type="email" id="modal-prov-correo" name="correo" class="form-control" maxlength="100">
  </div>
  <div class="form-group">
    <label for="modal-prov-dir" class="form-label">Dirección</label>
    <textarea id="modal-prov-dir" name="direccion" class="form-control" rows="2" maxlength="255"></textarea>
  </div>
  <div class="form-actions">
    <button type="button" class="btn btn-outline" data-modal-close="modal-crear-proveedor">Cancelar</button>
    <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Registrar</button>
  </div>
</form>
<%- include('../modal-end') %>
