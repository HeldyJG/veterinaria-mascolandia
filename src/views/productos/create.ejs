<%- include('../partials/head', { title: title }) %>
<%- include('../partials/sidebar') %>


  <!-- Breadcrumb -->
  <div class="page-header">
    <div class="page-header-left">
      <nav class="breadcrumb">
        <a href="/productos" class="breadcrumb-link">Productos</a>
        <span class="breadcrumb-sep">/</span>
        <span>Nuevo Producto</span>
      </nav>
    </div>
    <div class="page-header-right">
      <a href="/productos" class="btn btn-outline">
        <i data-lucide="arrow-left"></i>
        Volver
      </a>
    </div>
  </div>

  <!-- Formulario -->
  <div class="card" style="max-width: 720px; margin: 0 auto;">
    <div class="card-header">
      <span class="card-title">
        <i data-lucide="package-plus"></i>
        Registrar Nuevo Producto
      </span>
    </div>
    <div class="card-body">
      <form method="POST" action="/productos" novalidate>

        <!-- Nombre -->
        <div class="form-group">
          <label for="nombre" class="form-label">
            Nombre <span class="text-danger">*</span>
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            class="form-control"
            placeholder="Ej: Shampoo para perros 500ml"
            maxlength="150"
            required
          />
          <small class="form-hint">Nombre descriptivo del producto. Mínimo 2 caracteres.</small>
        </div>

        <!-- Código de Barras -->
        <div class="form-group">
          <label for="codigoBarras" class="form-label">Código de Barras</label>
          <input
            type="text"
            id="codigoBarras"
            name="codigoBarras"
            class="form-control"
            placeholder="Ej: 7501234567890"
            maxlength="50"
          />
          <small class="form-hint">Opcional. Debe ser único si se ingresa.</small>
        </div>

        <!-- Categoría y Proveedor en fila -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">

          <!-- Categoría -->
          <div class="form-group">
            <label for="idCategoria" class="form-label">
              Categoría <span class="text-danger">*</span>
            </label>
            <select id="idCategoria" name="idCategoria" class="form-control" required>
              <option value="">— Seleccionar categoría —</option>
              <% categorias.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.nombre %></option>
              <% }) %>
            </select>
            <small class="form-hint">Categoría del producto.</small>
          </div>

          <!-- Proveedor -->
          <div class="form-group">
            <label for="idProveedor" class="form-label">Proveedor</label>
            <select id="idProveedor" name="idProveedor" class="form-control">
              <option value="">— Sin proveedor —</option>
              <% proveedores.forEach(prov => { %>
                <option value="<%= prov.id %>"><%= prov.nombreEmpresa %></option>
              <% }) %>
            </select>
            <small class="form-hint">Opcional.</small>
          </div>

        </div>

        <!-- Precios en fila -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">

          <!-- Precio Compra -->
          <div class="form-group">
            <label for="precioCompra" class="form-label">
              Precio Compra (S/.) <span class="text-danger">*</span>
            </label>
            <input
              type="number"
              id="precioCompra"
              name="precioCompra"
              class="form-control"
              placeholder="0.00"
              min="0"
              step="0.01"
              required
            />
            <small class="form-hint">Precio de adquisición.</small>
          </div>

          <!-- Precio Venta -->
          <div class="form-group">
            <label for="precioVenta" class="form-label">
              Precio Venta (S/.) <span class="text-danger">*</span>
            </label>
            <input
              type="number"
              id="precioVenta"
              name="precioVenta"
              class="form-control"
              placeholder="0.00"
              min="0"
              step="0.01"
              required
            />
            <small class="form-hint">Precio de venta al público.</small>
          </div>

        </div>

        <!-- Stock en fila -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">

          <!-- Stock Actual -->
          <div class="form-group">
            <label for="stockActual" class="form-label">
              Stock Actual <span class="text-danger">*</span>
            </label>
            <input
              type="number"
              id="stockActual"
              name="stockActual"
              class="form-control"
              placeholder="0"
              min="0"
              step="1"
              required
            />
            <small class="form-hint">Cantidad disponible en inventario.</small>
          </div>

          <!-- Stock Mínimo -->
          <div class="form-group">
            <label for="stockMinimo" class="form-label">
              Stock Mínimo <span class="text-danger">*</span>
            </label>
            <input
              type="number"
              id="stockMinimo"
              name="stockMinimo"
              class="form-control"
              placeholder="5"
              min="0"
              step="1"
              required
            />
            <small class="form-hint">Alerta cuando el stock baje de este valor.</small>
          </div>

        </div>

        <!-- Descripción -->
        <div class="form-group">
          <label for="descripcion" class="form-label">Descripción</label>
          <textarea
            id="descripcion"
            name="descripcion"
            class="form-control"
            rows="3"
            placeholder="Descripción adicional del producto..."
          ></textarea>
          <small class="form-hint">Opcional. Información adicional del producto.</small>
        </div>

        <!-- Botones -->
        <div class="form-actions">
          <a href="/productos" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Registrar Producto
          </button>
        </div>

      </form>
    </div>
  </div>


<%- include('../partials/footer') %>
