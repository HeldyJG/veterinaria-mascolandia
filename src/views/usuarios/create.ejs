<%- include('../partials/head', { title: title }) %>
<%- include('../partials/sidebar') %>


  <div class="page-header">
    <div class="page-header-left">
      <nav class="breadcrumb">
        <a href="/usuarios" class="breadcrumb-link">Usuarios</a>
        <span class="breadcrumb-sep">/</span>
        <span>Nuevo</span>
      </nav>
    </div>
    <div class="page-header-right">
      <a href="/usuarios" class="btn btn-outline">
        <i data-lucide="arrow-left"></i>
        Volver
      </a>
    </div>
  </div>

  <div class="card" style="max-width: 640px; margin: 0 auto;">
    <div class="card-header">
      <span class="card-title">
        <i data-lucide="user-plus"></i>
        Registrar Usuario
      </span>
    </div>
    <div class="card-body">
      <form method="POST" action="/usuarios" novalidate>
        <div class="form-group">
          <label for="nombre" class="form-label">Nombre completo <span class="text-danger">*</span></label>
          <input type="text" id="nombre" name="nombre" class="form-control" minlength="3" maxlength="100" required>
        </div>

        <div class="form-group">
          <label for="usuario" class="form-label">Nombre de usuario <span class="text-danger">*</span></label>
          <input
            type="text"
            id="usuario"
            name="usuario"
            class="form-control"
            minlength="4"
            maxlength="50"
            pattern="[a-zA-Z0-9._-]+"
            required
          >
          <small class="form-hint">Solo letras, números y . _ - (único en el sistema).</small>
        </div>

        <div class="form-group">
          <label for="correo" class="form-label">Correo electrónico</label>
          <input type="email" id="correo" name="correo" class="form-control" maxlength="255">
        </div>

        <div class="form-group">
          <label for="idPerfil" class="form-label">Perfil <span class="text-danger">*</span></label>
          <select id="idPerfil" name="idPerfil" class="form-control" required>
            <option value="">— Seleccione un perfil —</option>
            <% perfiles.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.nombre %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="clave" class="form-label">Contraseña <span class="text-danger">*</span></label>
          <input
            type="password"
            id="clave"
            name="clave"
            class="form-control"
            minlength="8"
            required
            autocomplete="new-password"
          >
          <small class="form-hint">Mínimo 8 caracteres, al menos una letra y un número.</small>
        </div>

        <div class="form-actions">
          <a href="/usuarios" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Registrar
          </button>
        </div>
      </form>
    </div>
  </div>


<%- include('../partials/footer') %>
