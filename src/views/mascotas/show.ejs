<%- include('../partials/head', { title: title }) %>
<%- include('../partials/sidebar') %>


  <!-- Breadcrumb -->
  <div class="page-header">
    <div class="page-header-left">
      <nav class="breadcrumb">
        <a href="/mascotas" class="breadcrumb-link">Mascotas</a>
        <span class="breadcrumb-sep">/</span>
        <span><%= mascota.nombre %></span>
      </nav>
    </div>
    <div class="page-header-right">
      <a href="/mascotas/<%= mascota.id %>/editar" class="btn btn-warning">
        <i data-lucide="pencil"></i>
        Editar
      </a>
      <a href="/mascotas" class="btn btn-outline">
        <i data-lucide="arrow-left"></i>
        Volver
      </a>
    </div>
  </div>

  <!-- Detalle de la mascota -->
  <div class="card mb-4">
    <div class="card-header">
      <span class="card-title">
        <i data-lucide="heart"></i>
        Información de la Mascota
      </span>
    </div>
    <div class="card-body">
      <div style="display:flex; gap:24px; align-items:flex-start; flex-wrap:wrap;">

        <!-- Foto -->
        <div style="flex-shrink:0;">
          <% if (mascota.foto) { %>
            <img
              src="/uploads/fotos/<%= mascota.foto %>"
              alt="<%= mascota.nombre %>"
              style="width:160px; height:160px; object-fit:cover; border-radius:12px; border:2px solid #334155;"
            />
          <% } else { %>
            <div style="width:160px; height:160px; background:#1e293b; border-radius:12px; border:2px solid #334155; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px;">
              <i data-lucide="heart" style="width:48px; height:48px; color:#475569;"></i>
              <span style="color:#64748b; font-size:0.8rem;">Sin foto</span>
            </div>
          <% } %>
        </div>

        <!-- Datos -->
        <div style="flex:1; min-width:280px;">
          <div class="detail-grid">

            <div class="detail-item">
              <span class="detail-label">Nombre</span>
              <span class="detail-value fw-semibold"><%= mascota.nombre %></span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Cliente</span>
              <span class="detail-value">
                <% if (mascota.cliente) { %>
                  <a href="/clientes/<%= mascota.cliente.id %>" style="color:#6366f1;">
                    <%= mascota.cliente.nombreCompleto %>
                  </a>
                <% } else { %>
                  —
                <% } %>
              </span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Especie</span>
              <span class="detail-value">
                <%= (mascota.raza && mascota.raza.especie) ? mascota.raza.especie.nombre : '—' %>
              </span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Raza</span>
              <span class="detail-value"><%= mascota.raza ? mascota.raza.nombre : '—' %></span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Sexo</span>
              <span class="detail-value">
                <% if (mascota.sexo === 'MACHO') { %>
                  <span class="badge badge-info">Macho</span>
                <% } else if (mascota.sexo === 'HEMBRA') { %>
                  <span class="badge" style="background:#ec4899; color:#fff;">Hembra</span>
                <% } else { %>
                  —
                <% } %>
              </span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Fecha de Nacimiento</span>
              <span class="detail-value">
                <% if (mascota.fechaNacimiento) { %>
                  <%= new Date(mascota.fechaNacimiento).toLocaleDateString('es-PE') %>
                <% } else { %>
                  —
                <% } %>
              </span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Edad</span>
              <span class="detail-value">
                <% if (edad) { %>
                  <% if (edad.años > 0 && edad.meses > 0) { %>
                    <%= edad.años %> año<%= edad.años !== 1 ? 's' : '' %> y <%= edad.meses %> mes<%= edad.meses !== 1 ? 'es' : '' %>
                  <% } else if (edad.años > 0) { %>
                    <%= edad.años %> año<%= edad.años !== 1 ? 's' : '' %>
                  <% } else { %>
                    <%= edad.meses %> mes<%= edad.meses !== 1 ? 'es' : '' %>
                  <% } %>
                <% } else { %>
                  —
                <% } %>
              </span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Peso Actual</span>
              <span class="detail-value">
                <% if (mascota.pesoActual) { %>
                  <%= parseFloat(mascota.pesoActual).toFixed(2) %> kg
                <% } else { %>
                  —
                <% } %>
              </span>
            </div>

            <div class="detail-item">
              <span class="detail-label">Color / Pelaje</span>
              <span class="detail-value"><%= mascota.color || '—' %></span>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Historial Clínico -->
  <div class="card mb-4">
    <div class="card-header">
      <span class="card-title">
        <i data-lucide="clipboard-list"></i>
        Historial Clínico
        <span class="badge badge-info"><%= historiales.length %></span>
      </span>
    </div>
    <div class="card-body p-0">
      <% if (historiales.length === 0) { %>
        <div class="empty-state">
          <i data-lucide="clipboard-x"></i>
          <p>Esta mascota no tiene historial clínico registrado.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Veterinario</th>
                <th>Diagnóstico</th>
                <th class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% historiales.forEach((historial, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td>
                    <%= historial.fechaRegistro
                      ? new Date(historial.fechaRegistro).toLocaleDateString('es-PE')
                      : '—' %>
                  </td>
                  <td><%= historial.usuario ? historial.usuario.nombre : '—' %></td>
                  <td class="text-truncate" style="max-width:300px;" title="<%= historial.diagnostico || '' %>">
                    <%= historial.diagnostico || '—' %>
                  </td>
                  <td class="text-center">
                    <a href="/historiales/<%= historial.id %>" class="btn btn-sm btn-info" title="Ver detalle">
                      <i data-lucide="eye"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Citas -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">
        <i data-lucide="calendar"></i>
        Citas
        <span class="badge badge-info"><%= citas.length %></span>
      </span>
    </div>
    <div class="card-body p-0">
      <% if (citas.length === 0) { %>
        <div class="empty-state">
          <i data-lucide="calendar-x"></i>
          <p>Esta mascota no tiene citas registradas.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Servicio</th>
                <th class="text-center">Estado</th>
              </tr>
            </thead>
            <tbody>
              <% citas.forEach((cita, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= cita.fecha ? new Date(cita.fecha).toLocaleDateString('es-PE') : '—' %></td>
                  <td><%= cita.hora ? cita.hora.substring(0, 5) : '—' %></td>
                  <td><%= cita.servicio ? cita.servicio.nombre : '—' %></td>
                  <td class="text-center">
                    <%
                      let badgeClass = 'badge-secondary';
                      if (cita.estado === 'PENDIENTE') badgeClass = 'badge-warning';
                      else if (cita.estado === 'CONFIRMADA') badgeClass = 'badge-info';
                      else if (cita.estado === 'ATENDIDA') badgeClass = 'badge-success';
                      else if (cita.estado === 'CANCELADA') badgeClass = 'badge-danger';
                    %>
                    <span class="badge <%= badgeClass %>"><%= cita.estado %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>


<%- include('../partials/footer') %>
