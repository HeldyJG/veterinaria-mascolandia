<%- include('../partials/head', { title: title }) %>
<%- include('../partials/sidebar') %>


  <!-- Breadcrumb -->
  <div class="page-header">
    <div class="page-header-left">
      <nav class="breadcrumb">
        <a href="/historial-clinico" class="breadcrumb-link">Historial Clínico</a>
        <span class="breadcrumb-sep">/</span>
        <span>Nuevo Registro</span>
      </nav>
    </div>
    <div class="page-header-right">
      <a href="/historial-clinico" class="btn btn-outline">
        <i data-lucide="arrow-left"></i>
        Volver
      </a>
    </div>
  </div>

  <!-- Info de la cita (si viene desde una cita) -->
  <% if (cita) { %>
    <div class="card mb-4" style="border-left: 4px solid #6366f1;">
      <div class="card-header">
        <span class="card-title">
          <i data-lucide="calendar-check"></i>
          Cita Asociada
        </span>
      </div>
      <div class="card-body">
        <div class="detail-grid">
          <div class="detail-item">
            <span class="detail-label">Mascota</span>
            <span class="detail-value fw-semibold">
              <%= cita.mascota ? cita.mascota.nombre : '—' %>
            </span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Cliente</span>
            <span class="detail-value">
              <%= (cita.mascota && cita.mascota.cliente) ? cita.mascota.cliente.nombreCompleto : '—' %>
            </span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Servicio</span>
            <span class="detail-value">
              <%= cita.servicio ? cita.servicio.nombre : '—' %>
            </span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Fecha de Cita</span>
            <span class="detail-value">
              <%= cita.fecha ? new Date(cita.fecha).toLocaleDateString('es-PE') : '—' %>
              <% if (cita.hora) { %> — <%= cita.hora.substring(0, 5) %><% } %>
            </span>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Formulario -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">
        <i data-lucide="file-plus"></i>
        Registrar Historial Clínico
      </span>
    </div>
    <div class="card-body">
      <form method="POST" action="/historial-clinico" novalidate>

        <% if (cita) { %>
          <input type="hidden" name="idCita" value="<%= cita.id %>" />
        <% } %>

        <!-- Fila: Mascota + Veterinario -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">

          <!-- Mascota -->
          <div class="form-group">
            <label for="idMascota" class="form-label">
              Mascota <span class="text-danger">*</span>
            </label>
            <% if (cita && cita.mascota) { %>
              <input
                type="hidden"
                name="idMascota"
                value="<%= cita.mascota.id %>"
              />
              <input
                type="text"
                class="form-control"
                value="<%= cita.mascota.nombre %> (<%= cita.mascota.cliente ? cita.mascota.cliente.nombreCompleto : '' %>)"
                disabled
              />
            <% } else { %>
              <select id="idMascota" name="idMascota" class="form-control" required>
                <option value="">— Seleccionar mascota —</option>
                <% mascotas.forEach(mascota => { %>
                  <option value="<%= mascota.id %>">
                    <%= mascota.nombre %>
                    <% if (mascota.cliente) { %> — <%= mascota.cliente.nombreCompleto %><% } %>
                    <% if (mascota.raza) { %> (<%= mascota.raza.nombre %>)<% } %>
                  </option>
                <% }) %>
              </select>
            <% } %>
            <small class="form-hint">Mascota a la que pertenece este historial.</small>
          </div>

          <!-- Veterinario -->
          <div class="form-group">
            <label for="idUsuario" class="form-label">
              Veterinario <span class="text-danger">*</span>
            </label>
            <select id="idUsuario" name="idUsuario" class="form-control" required>
              <option value="">— Seleccionar veterinario —</option>
              <% usuarios.forEach(usuario => { %>
                <option value="<%= usuario.id %>"><%= usuario.nombre %></option>
              <% }) %>
            </select>
            <small class="form-hint">Profesional que atiende la consulta.</small>
          </div>

        </div>

        <!-- Motivo de Consulta -->
        <div class="form-group">
          <label for="motivoConsulta" class="form-label">Motivo de Consulta</label>
          <input
            type="text"
            id="motivoConsulta"
            name="motivoConsulta"
            class="form-control"
            placeholder="Ej: Revisión general, vacunación, malestar digestivo..."
            maxlength="255"
          />
          <small class="form-hint">Razón principal de la visita.</small>
        </div>

        <!-- Síntomas -->
        <div class="form-group">
          <label for="sintomas" class="form-label">Síntomas</label>
          <textarea
            id="sintomas"
            name="sintomas"
            class="form-control"
            rows="3"
            placeholder="Describa los síntomas observados..."
          ></textarea>
        </div>

        <!-- Fila: Peso + Temperatura -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">

          <div class="form-group">
            <label for="peso" class="form-label">Peso (kg)</label>
            <input
              type="number"
              id="peso"
              name="peso"
              class="form-control"
              placeholder="Ej: 4.50"
              step="0.01"
              min="0"
              max="999.99"
            />
            <small class="form-hint">Peso actual de la mascota en kilogramos.</small>
          </div>

          <div class="form-group">
            <label for="temperatura" class="form-label">Temperatura (°C)</label>
            <input
              type="number"
              id="temperatura"
              name="temperatura"
              class="form-control"
              placeholder="Ej: 38.5"
              step="0.1"
              min="0"
              max="99.9"
            />
            <small class="form-hint">Temperatura corporal en grados Celsius.</small>
          </div>

        </div>

        <!-- Diagnóstico -->
        <div class="form-group">
          <label for="diagnostico" class="form-label">Diagnóstico</label>
          <textarea
            id="diagnostico"
            name="diagnostico"
            class="form-control"
            rows="3"
            placeholder="Diagnóstico clínico del veterinario..."
          ></textarea>
        </div>

        <!-- Tratamiento -->
        <div class="form-group">
          <label for="tratamiento" class="form-label">Tratamiento</label>
          <textarea
            id="tratamiento"
            name="tratamiento"
            class="form-control"
            rows="3"
            placeholder="Medicamentos, procedimientos, indicaciones..."
          ></textarea>
        </div>

        <!-- Observaciones -->
        <div class="form-group">
          <label for="observaciones" class="form-label">Observaciones</label>
          <textarea
            id="observaciones"
            name="observaciones"
            class="form-control"
            rows="2"
            placeholder="Notas adicionales, seguimiento recomendado..."
          ></textarea>
        </div>

        <!-- Botones -->
        <div class="form-actions">
          <a href="/historial-clinico" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Registrar Historial
          </button>
        </div>

      </form>
    </div>
  </div>


<%- include('../partials/footer') %>
