<%- include('partials/head', { title: typeof title !== 'undefined' ? title : 'Reportes | Mascolandia' }) %>
  <%- include('partials/sidebar') %>

  <!-- Cabecera de Reportes y Filtro de Fecha -->
  <div class="card-premium" style="margin-bottom: 2rem; padding: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
    <div>
      <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Panel de Analíticas del Negocio</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Monitorea ingresos, atenciones, clientes frecuentes y alertas de insumos.</p>
    </div>
    
    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <div class="form-group" style="margin-bottom: 0; min-width: 180px;">
        <select id="periodo-select" class="form-control" style="padding-left: 1rem;" onchange="manejarPeriodo()">
          <option value="hoy">Hoy</option>
          <option value="semana">Esta Semana</option>
          <option value="mes" selected>Este Mes</option>
          <option value="trimestre">Último Trimestre</option>
          <option value="anio">Este Año</option>
          <option value="personalizado">Rango Personalizado</option>
        </select>
      </div>

      <div id="rango-fechas" style="display: none; gap: 0.5rem; align-items: center;">
        <input type="date" id="fecha-inicio" class="form-control" style="padding: 0.4rem 1rem; width: 140px;">
        <span style="color: var(--text-muted);">a</span>
        <input type="date" id="fecha-fin" class="form-control" style="padding: 0.4rem 1rem; width: 140px;">
      </div>

      <button onclick="cargarReportes()" class="btn-premium-sm primary" style="padding: 0.5rem 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="refresh-cw" style="width: 16px; height: 16px;"></i>
        <span>Actualizar</span>
      </button>
      <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
        <button type="button" onclick="exportarReporte('completo')" class="btn-premium-sm" style="border:1px solid var(--border-color);">
          <i data-lucide="download" style="width:14px;height:14px;"></i> Resumen CSV
        </button>
        <button type="button" onclick="exportarReporte('ventas')" class="btn-premium-sm" style="border:1px solid var(--border-color);">
          <i data-lucide="file-spreadsheet" style="width:14px;height:14px;"></i> Ventas
        </button>
        <button type="button" onclick="exportarReporte('inventario')" class="btn-premium-sm" style="border:1px solid var(--border-color);">
          <i data-lucide="package" style="width:14px;height:14px;"></i> Inventario
        </button>
      </div>
    </div>
  </div>

  <!-- Pestañas de reportes -->
  <div class="tabs-row">
    <button type="button" class="btn-premium-sm primary tab-reporte active" data-tab="resumen" onclick="cambiarTab('resumen')">Resumen</button>
    <button type="button" class="btn-premium-sm tab-reporte" data-tab="ventas" onclick="cambiarTab('ventas')">Ventas</button>
    <button type="button" class="btn-premium-sm tab-reporte" data-tab="servicios" onclick="cambiarTab('servicios')">Servicios</button>
    <button type="button" class="btn-premium-sm tab-reporte" data-tab="clientes" onclick="cambiarTab('clientes')">Clientes</button>
    <button type="button" class="btn-premium-sm tab-reporte" data-tab="inventario" onclick="cambiarTab('inventario')">Inventario</button>
  </div>

  <div id="panel-resumen" class="panel-reporte">

  <!-- Tarjetas KPI -->
  <div class="grid-stats" style="margin-bottom: 2rem;">
    <!-- Tarjeta 1: Ingresos -->
    <div class="stat-card" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%); border-color: rgba(168, 85, 247, 0.3);">
      <div class="stat-icon" style="background: rgba(168, 85, 247, 0.2); color: #a855f7;">
        <i data-lucide="dollar-sign" style="width: 28px; height: 28px;"></i>
      </div>
      <div class="stat-info">
        <div class="stat-value" id="kpi-ingresos">S/. 0.00</div>
        <div class="stat-label">Ingresos del Período</div>
        <div style="font-size: 0.8rem; font-weight: 600; margin-top: 0.25rem;" id="kpi-ingresos-comparacion">0% vs anterior</div>
      </div>
    </div>

    <!-- Tarjeta 2: Servicios -->
    <div class="stat-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.15) 100%); border-color: rgba(16, 185, 129, 0.3);">
      <div class="stat-icon" style="background: rgba(16, 185, 129, 0.2); color: #10b981;">
        <i data-lucide="activity" style="width: 28px; height: 28px;"></i>
      </div>
      <div class="stat-info">
        <div class="stat-value" id="kpi-servicios">0</div>
        <div class="stat-label">Servicios Realizados</div>
        <div style="font-size: 0.8rem; font-weight: 600; margin-top: 0.25rem;" id="kpi-servicios-comparacion">0 vs anterior</div>
      </div>
    </div>

    <!-- Tarjeta 3: Clientes -->
    <div class="stat-card" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6) 100%); border-color: rgba(245, 158, 11, 0.3);">
      <div class="stat-icon" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b;">
        <i data-lucide="users" style="width: 28px; height: 28px;"></i>
      </div>
      <div class="stat-info">
        <div class="stat-value" id="kpi-clientes">0</div>
        <div class="stat-label">Clientes Atendidos</div>
        <div style="font-size: 0.8rem; font-weight: 600; margin-top: 0.25rem;" id="kpi-clientes-comparacion">+0% nuevos</div>
      </div>
    </div>

    <!-- Tarjeta 4: Ticket Promedio -->
    <div class="stat-card" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.15) 0%, rgba(8, 145, 178, 0.15) 100%); border-color: rgba(6, 182, 212, 0.3);">
      <div class="stat-icon" style="background: rgba(6, 182, 212, 0.2); color: #06b6d4;">
        <i data-lucide="trending-up" style="width: 28px; height: 28px;"></i>
      </div>
      <div class="stat-info">
        <div class="stat-value" id="kpi-ticket">S/. 0.00</div>
        <div class="stat-label">Ticket Promedio</div>
        <div style="font-size: 0.8rem; font-weight: 600; margin-top: 0.25rem;" id="kpi-ticket-comparacion">0% vs anterior</div>
      </div>
    </div>
  </div>

  <!-- Sección de Gráficos -->
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2rem;">
    <!-- Gráfico de ingresos -->
    <div class="card-premium">
      <div class="card-premium-header">
        <div class="card-premium-title">Historial de Ingresos Diarios</div>
      </div>
      <div style="position: relative; height: 300px; width: 100%;">
        <canvas id="chart-ingresos"></canvas>
      </div>
