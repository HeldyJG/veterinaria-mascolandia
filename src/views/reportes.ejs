  <!-- Sección de Listas y Alertas -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
    <!-- Servicios Solicitados -->
    <div class="card-premium">
      <div class="card-premium-header">
        <div class="card-premium-title">Servicios Más Demandados</div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 1rem;" id="lista-servicios-demandados">
