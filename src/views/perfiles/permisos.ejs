<%- include('../partials/head', { title: title }) %>
  <%- include('../partials/sidebar') %>

  <div class="card-premium">
    <div class="card-premium-header">
      <div class="card-premium-title">
        <i data-lucide="shield-check" style="width:20px; height:20px; margin-right:0.5rem; vertical-align:middle;"></i>
        Permisos: <%= perfil.nombre %>
      </div>
      <a href="/perfiles/listar" class="btn-premium-sm" style="border: 1px solid var(--border-color); color: var(--text-main); text-decoration: none;">
        <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
        Volver
      </a>
    </div>

    <% if (perfil.descripcion) { %>
      <p style="color: var(--text-muted); margin-bottom: 1rem;"><%= perfil.descripcion %></p>
    <% } %>

    <form method="POST" action="/perfiles/<%= perfil.id %>/permisos?_method=PUT">
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <% grupos.forEach(grupo => { %>
          <div style="border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem; background: rgba(255,255,255,0.02);">
            <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; margin-bottom: 0.75rem; cursor: pointer;">
              <input
                type="checkbox"
                name="opciones"
                value="<%= grupo.id %>"
                <%= asignadasIds.includes(String(grupo.id)) ? 'checked' : '' %>
              />
              <span><%= grupo.nombre %></span>
              <% if (grupo.ruta && String(grupo.ruta).startsWith('#')) { %>
                <small style="color: var(--text-muted); font-weight: 400;">(grupo de menú)</small>
              <% } %>
            </label>

            <% if (grupo.hijos && grupo.hijos.length > 0) { %>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.5rem; padding-left: 1.5rem;">
                <% grupo.hijos.forEach(hijo => { %>
                  <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-main); font-size: 0.9rem;">
                    <input
                      type="checkbox"
                      name="opciones"
                      value="<%= hijo.id %>"
                      <%= asignadasIds.includes(String(hijo.id)) ? 'checked' : '' %>
                    />
                    <span><%= hijo.nombre %></span>
                  </label>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
        <a href="/perfiles/listar" class="btn-premium-sm" style="border: 1px solid var(--border-color); color: var(--text-main); text-decoration: none;">Cancelar</a>
        <button type="submit" class="btn-premium-sm primary">
          <i data-lucide="save" style="width: 14px; height: 14px;"></i>
          Guardar permisos
        </button>
      </div>
    </form>
  </div>

  <%- include('../partials/footer') %>